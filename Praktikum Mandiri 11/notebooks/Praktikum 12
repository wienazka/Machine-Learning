55060  66.897537\n","4  34.810007  67.821210\n"]}]},{"cell_type":"markdown","metadata":{"id":"8c19034e"},"source":["## Terapkan Algoritma DBSCAN\n","\n","### Subtask:\n","Menerapkan algoritma clustering DBSCAN pada koordinat GPS yang diekstrak. Parameter seperti 'eps' (radius lingkungan) dan 'min_samples' (jumlah sampel minimum) akan ditentukan. Perlu diingat bahwa nilai-nilai ini mungkin perlu disesuaikan untuk hasil optimal.\n"]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":0},"id":"f07c25e6","executionInfo":{"status":"ok","timestamp":1764826264134,"user_tz":-420,"elapsed":839,"user":{"displayName":"Ahmad Azka Ridha","userId":"17658845007599300578"}},"outputId":"1fc405f3-a9ad-41ed-e116-4ad0af6e7a26"},"source":["from sklearn.cluster import DBSCAN\n","from sklearn.preprocessing import MinMaxScaler\n","from sklearn.compose import make_column_transformer\n","print(\"Imported DBSCAN, MinMaxScaler, and make_column_transformer.\")"],"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["Imported DBSCAN, MinMaxScaler, and make_column_transformer.\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":0},"id":"19d67c99","executionInfo":{"status":"ok","timestamp":1764826315758,"user_tz":-420,"elapsed":45,"user":{"displayName":"Ahmad Azka Ridha","userId":"17658845007599300578"}},"outputId":"ee46b712-f447-4c87-f409-091c1cbc805f"},"source":["df_cleaned = df.dropna(subset=['latitude', 'longitude']).copy()\n","coordinates_cleaned = df_cleaned[['latitude', 'longitude']]\n","\n","preprocessor = make_column_transformer(\n","    (MinMaxScaler(), ['latitude', 'longitude']),\n","    remainder='passthrough'\n",")\n","\n","scaled_coordinates = preprocessor.fit_transform(coordinates_cleaned)\n","\n","# Initialize DBSCAN model\n","# eps (epsilon): The maximum distance between two samples for one to be considered as in the neighborhood of the other.\n","# min_samples: The number of samples (or total weight) in a neighborhood for a point to be considered as a core point.\n","# Adjust these values for optimal results based on data characteristics.\n","dbscan = DBSCAN(eps=0.05, min_samples=5)\n","\n","# Fit the model and predict clusters\n","clusters = dbscan.fit_predict(scaled_coordinates)\n","\n","# Add the cluster labels to the cleaned dataframe\n","df_cleaned['cluster'] = clusters\n","\n","print(\"DBSCAN clustering applied to cleaned data.\")\n","print(\"Number of clusters found (excluding noise):\", len(set(clusters)) - (1 if -1 in clusters else 0))\n","print(\"First 5 rows of cleaned dataframe with cluster labels:\")\n","print(df_cleaned[['latitude', 'longitude', 'cluster']].head())"],"execution_count":6,"outputs":[{"output_type":"stream","name":"stdout","text":["DBSCAN clustering applied to cleaned data.\n","Number of clusters found (excluding noise): 5\n","First 5 rows of cleaned dataframe with cluster labels:\n","    latitude  longitude  cluster\n","0  36.734772  70.811995        0\n","1  35.167134  63.769538        0\n","2  36.178903  68.745306        0\n","3  36.755060  66.897537        0\n","4  34.810007  67.821210        0\n"]}]},{"cell_type":"markdown","metadata":{"id":"ea911c13"},"source":["## Visualisasi Cluster GPS (Peta/Scatter Plot)\n","\n","### Subtask:\n","Membuat scatter plot atau visualisasi peta dari koordinat GPS, dengan setiap cluster DBSCAN diwarnai secara berbeda. Titik-titik yang dianggap noise akan diberi label atau warna khusus. Visualisasi ini akan berfungsi sebagai 'gambar yang dapat dijadikan bukti untuk laporan'.\n"]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":0},"id":"215e2a26","executionInfo":{"status":"ok","timestamp":1764826333344,"user_tz":-420,"elapsed":1096,"user":{"displayName":"Ahmad Azka Ridha","userId":"17658845007599300578"}},"outputId":"cb5e0757-4c8a-420b-a53a-8ed5cc297cf1"},"source":["import matplotlib.pyplot as plt\n","import seaborn as sns\n","print(\"Imported matplotlib.pyplot and seaborn for visualization.\")"],"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["Imported matplotlib.pyplot and seaborn for visualization.\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":718},"id":"c83e405c","executionInfo":{"status":"ok","timestamp":1764826352298,"user_tz":-420,"elapsed":8722,"user":{"displayName":"Ahmad Azka Ridha","userId":"17658845007599300578"}},"outputId":"41167c15-0bef-4f0a-8f8d-523387472e93"},"source":["plt.figure(figsize=(12, 8))\n","sns.scatterplot(\n","    data=df_cleaned,\n","    x='longitude',\n","    y='latitude',\n","    hue='cluster',\n","    palette='viridis',\n","    size=(df_cleaned['cluster'] != -1).astype(int), # Make noise points smaller\n","    sizes=(20, 100), # Size range for points\n","    legend='full'\n",")\n","\n","# Adjust color for noise points (-1)\n","# Noise points are typically shown in a different color, e.g., black or gray.\n","almost_black_color = '#333333' # A dark gray color\n","\n","# Create a custom palette to ensure noise is distinct\n","num_clusters = len(df_cleaned['cluster'].unique())\n","colors = sns.color_palette('viridis', n_colors=num_clusters -1)\n","if -1 in df_cleaned['cluster'].unique():\n","    # Add a distinct color for noise if it exists\n","    colors.append(almost_black_color)\n","    cluster_labels = sorted(df_cleaned['cluster'].unique())\n","    # Map the palette to ensure -1 always gets the last color (black/gray)\n","    palette_dict = {label: color for label, color in zip(cluster_labels, colors)}\n","    # Use a custom color for noise if it exists\n","    noise_mask = (df_cleaned['cluster'] == -1)\n","    sns.scatterplot(\n","        data=df_cleaned[~noise_mask],\n","        x='longitude',\n","        y='latitude',\n","        hue='cluster',\n","        palette=palette_dict,\n","        s=100, # Regular size for non-noise points\n","        legend='full'\n","    )\n","    sns.scatterplot(\n","        data=df_cleaned[noise_mask],\n","        x='longitude',\n","        y='latitude',\n","        color=almost_black_color,\n","        marker='X',\n","        s=50, # Smaller size for noise points\n","        label='Noise (-1)',\n","        legend='full'\n","    )\n","else:\n","    sns.scatterplot(\n","        data=df_cleaned,\n","        x='longitude',\n","        y='latitude',\n","        hue='cluster',\n","        palette='viridis',\n","        s=100, # Regular size for non-noise points\n","        legend='full'\n","    )\n","\n","plt.title('DBSCAN Clustering of GPS Coordinates')\n","plt.xlabel('Longitude')\n","plt.ylabel('Latitude')\n","plt.grid(True)\n","plt.show()\n"],"execution_count":8,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x800 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","metadata":{"id":"488e969b"},"source":["## Visualisasi Distribusi Kluster\n","\n","### Subtask:\n","Membuat bar chart yang menunjukkan distribusi data di antara kluster-kluster DBSCAN. Ini akan memberikan gambaran tentang ukuran relatif dari setiap kluster dan jumlah titik noise."]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":0},"id":"0039c7f9","executionInfo":{"status":"ok","timestamp":1764826371697,"user_tz":-420,"elapsed":20,"user":{"displayName":"Ahmad Azka Ridha","userId":"17658845007599300578"}},"outputId":"b2882b2b-b200-47cb-a267-dd16965d8572"},"source":["cluster_counts = df_cleaned['cluster'].value_counts().sort_index()\n","print(\"Cluster distribution:\")\n","print(cluster_counts.to_string())"],"execution_count":9,"outputs":[{"output_type":"stream","name":"stdout","text":["Cluster distribution:\n","cluster\n","-1      35\n"," 0    4061\n"," 1     774\n"," 2      17\n"," 3      15\n"," 4       5\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":564},"id":"14d380f7","executionInfo":{"status":"ok","timestamp":1764826443017,"user_tz":-420,"elapsed":1901,"user":{"displayName":"Ahmad Azka Ridha","userId":"17658845007599300578"}},"outputId":"907544f1-aec7-4a0d-c7af-ed1da3f586e3"},"source":["plt.figure(figsize=(10, 6))\n","sns.barplot(x=cluster_counts.index, y=cluster_counts.values, hue=cluster_counts.index, palette='viridis', legend=False)\n","plt.title('Distribution of DBSCAN Clusters')\n","plt.xlabel('Cluster Label')\n","plt.ylabel('Number of Points')\n","plt.xticks(rotation=0)\n","plt.grid(axis='y', linestyle='--', alpha=0.7)\n","plt.show()"],"execution_count":11,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","metadata":{"id":"014d958a"},"source":["### Deskripsi Alur Algoritma DBSCAN (untuk Flow Chart)\n","\n","Algoritma DBSCAN (Density-Based Spatial Clustering of Applications with Noise) adalah metode clustering yang mengelompokkan titik-titik data berdasarkan kepadatan konektivitas. Ini mengidentifikasi kluster sebagai area padat dari titik data yang dipisahkan oleh area kepadatan rendah, dan mampu menemukan kluster dengan bentuk arbitrer serta mengidentifikasi titik-titik noise.\n","\n","#### Konsep Dasar DBSCAN:\n","\n","1.  **Kepadatan (Density)**: Mengacu pada jumlah titik data dalam radius tertentu (epsilon atau `eps`) dari suatu titik. Ini adalah ukuran seberapa \"padat\" area di sekitar suatu titik.\n","2.  **Titik Inti (Core Point)**: Sebuah titik data `P` adalah titik inti jika ada setidaknya `MinPts` (minimum samples) titik data (termasuk `P` itu sendiri) dalam radius `eps` dari `P`. Ini menunjukkan bahwa `P` berada di area yang padat.\n","3.  **Titik Batas (Border Point)**: Sebuah titik data `Q` adalah titik batas jika berada dalam radius `eps` dari sebuah titik inti, tetapi `Q` sendiri bukan titik inti (yaitu, jumlah titik dalam radius `eps` dari `Q` kurang dari `MinPts`). Titik batas adalah bagian dari kluster tetapi berada di \"tepi\" kluster.\n","4.  **Titik Noise (Noise Point)**: Sebuah titik data `N` adalah titik noise jika bukan titik inti dan juga tidak dapat dijangkau dari titik inti mana pun (yaitu, tidak ada titik inti yang memiliki `N` dalam radius `eps`-nya). Titik-titik ini dianggap sebagai outlier.\n","\n","#### Langkah-langkah Utama Algoritma DBSCAN:\n","\n","1.  **Inisialisasi**: Pilih titik data `p` yang belum dikunjungi secara acak dari dataset.\n","2.  **Perluasan Lingkungan (Region Query)**:\n","    *   Periksa apakah `p` adalah titik inti dengan mencari semua titik yang berada dalam radius `eps` dari `p`. Sebut himpunan titik-titik ini sebagai `N_eps(p)`.\n","    *   Jika jumlah titik dalam `N_eps(p)` kurang dari `MinPts`, maka `p` awalnya dianggap sebagai noise (sementara) dan tandai `p` sebagai sudah dikunjungi. Algoritma kemudian kembali ke langkah 1 untuk memilih titik baru.\n","3.  **Pembentukan Kluster**: Jika jumlah titik dalam `N_eps(p)` lebih besar atau sama dengan `MinPts` (yaitu, `p` adalah titik inti):\n","    *   Mulai kluster baru `C` dan tambahkan `p` ke `C`. Tandai `p` sebagai sudah dikunjungi.\n","    *   Buat daftar `seed_list` yang berisi semua titik di `N_eps(p)` (kecuali `p` itu sendiri).\n","    *   Untuk setiap titik `q` dalam `seed_list`:\n","        *   Jika `q` belum dikunjungi:\n","            *   Tandai `q` sebagai sudah dikunjungi.\n","            *   Lakukan pencarian lingkungan `N_eps(q)`.\n","            *   Jika jumlah titik dalam `N_eps(q)` lebih besar atau sama dengan `MinPts`, maka tambahkan semua titik di `N_eps(q)` yang belum ada di `seed_list` ke `seed_list`.\n","        *   Jika `q` bukan anggota dari kluster mana pun, tambahkan `q` ke kluster `C`.\n","4.  **Iterasi**: Ulangi langkah 1 hingga 3 sampai semua titik dalam dataset telah dikunjungi atau diberi label sebagai noise."]}]}